{
  "name": "root",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.20.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @root/trpc-contract build && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @root/database db:generate",
    "db:validate": "pnpm --filter @root/database db:validate",
    "db:migrate:dev": "pnpm --filter @root/database db:migrate:dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  }
}

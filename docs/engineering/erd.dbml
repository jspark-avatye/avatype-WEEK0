// Basic nine-table ERD including Refresh Token. Additional integrity rules: erd.md.
Project english_conversation_assessment {
  database_type: 'PostgreSQL'
}

Enum account_state {
  ACTIVE
  DISABLED
}

Enum proficiency_band_code {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

Enum proficiency_level_code {
  BEGINNER_LOW
  BEGINNER_MID
  BEGINNER_HIGH
  INTERMEDIATE_LOW
  INTERMEDIATE_MID
  INTERMEDIATE_HIGH
  ADVANCED_LOW
  ADVANCED_MID
  ADVANCED_HIGH
}

Enum evaluation_status {
  READY
  IN_PROGRESS
  PAUSED
  ENDING
  ANALYSIS_PENDING
  ANALYZING
  COMPLETED
  ANALYSIS_FAILED
}

Enum answer_processing_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum evaluation_verdict {
  CONFIRMED
  PROVISIONAL
  UNASSESSABLE
}

Enum assessment_criterion_code {
  VOCABULARY
  GRAMMAR
  PRONUNCIATION
  FLUENCY
  RELEVANCE
}

Enum feedback_kind {
  IMPROVEMENT
  EXPRESSION_CORRECTION
}

Table user_account {
  user_id uuid [not null, pk, note: '회원 ID']
  login_id text [not null, unique, note: '로그인 ID']
  password_hash text [not null, note: '비밀번호 해시']
  account_status account_state [not null, note: '계정 상태']
  current_level_code proficiency_level_code [null, note: '현재 평가 수준']
  created_at timestamptz [not null, note: '생성 시각']
  Note: '회원 계정'
}

Table refresh_token {
  token_id uuid [not null, pk, note: '토큰 ID']
  user_id uuid [not null, note: '회원 ID']
  token_hash text [not null, unique, note: '토큰 해시; 원문 저장 금지']
  created_at timestamptz [not null, note: '최초 발급 시각']
  expires_at timestamptz [not null, note: '만료 시각']
  revoked_at timestamptz [null, note: '폐기 시각']
  Note: '리프레시 토큰; 갱신 시 해시 교체, 최초 만료 시각 유지'
}

Table evaluation_session {
  evaluation_id uuid [not null, pk, note: '평가 ID']
  user_id uuid [not null, note: '회원 ID']
  starting_band_code proficiency_band_code [not null, note: '시작 수준']
  status evaluation_status [not null, note: '평가 상태']
  created_at timestamptz [not null, note: '생성 시각']
  started_at timestamptz [null, note: '시작 시각']
  paused_at timestamptz [null, note: '최근 일시정지 시각']
  ended_at timestamptz [null, note: '종료 시각']
  Note: '평가 세션'
}

Table question {
  question_id uuid [not null, pk, note: '질문 ID']
  evaluation_id uuid [not null, note: '평가 ID']
  question_no integer [not null, note: '질문 순서']
  content text [not null, note: '질문 내용']
  difficulty_level_code proficiency_level_code [not null, note: '질문 난이도']
  audio_id uuid [null, unique, note: '질문 음성 ID']
  created_at timestamptz [not null, note: '생성 시각']
  indexes {
    (evaluation_id, question_no) [unique]
  }
  Note: '질문'
}

Table answer {
  answer_id uuid [not null, pk, note: '답변 ID']
  question_id uuid [not null, unique, note: '질문 ID']
  audio_id uuid [not null, unique, note: '답변 음성 ID']
  transcript text [null, note: '전체 전사문']
  processing_status answer_processing_status [not null, note: '처리 상태']
  accepted_at timestamptz [not null, note: '답변 접수 시각']
  Note: '답변'
}

Table audio_asset {
  audio_id uuid [not null, pk, note: '음성 ID']
  object_key text [not null, unique, note: '프리픽스를 포함한 전체 객체 키']
  mime_type text [not null, note: 'MIME 타입']
  byte_size bigint [not null, note: '파일 크기(바이트)']
  duration_ms bigint [not null, note: '음성 길이(밀리초)']
  created_at timestamptz [not null, note: '저장 시각']
  Note: '음성 자원; 단일 고정 버킷은 서버 설정에서 관리'
}

Table evaluation_report {
  report_id uuid [not null, pk, note: '보고서 ID']
  evaluation_id uuid [not null, unique, note: '평가 ID']
  final_level_code proficiency_level_code [null, note: '최종 평가 수준']
  verdict evaluation_verdict [not null, note: '평가 판정']
  summary text [not null, note: '종합 평가 설명']
  created_at timestamptz [not null, note: '보고서 생성 시각']
  Note: '평가 보고서'
}

Table criterion_result {
  result_id uuid [not null, pk, note: '항목 결과 ID']
  report_id uuid [not null, note: '보고서 ID']
  criterion_code assessment_criterion_code [not null, note: '평가 항목 코드']
  score numeric(8,3) [null, note: '항목 점수']
  insufficient_reason text [null, note: '평가 데이터 부족 사유']
  rationale text [not null, note: '항목 판단 이유']
  indexes {
    (report_id, criterion_code) [unique]
  }
  Note: '평가 항목 결과'
}

Table criterion_feedback {
  feedback_id uuid [not null, pk, note: '피드백 ID']
  result_id uuid [not null, note: '항목 결과 ID']
  feedback_no integer [not null, note: '피드백 순서']
  feedback_kind feedback_kind [not null, note: '피드백 종류']
  suggestion text [not null, note: '개선 제안 또는 수정 표현']
  explanation text [not null, note: '제안 이유']
  indexes {
    (result_id, feedback_no) [unique]
  }
  Note: '평가 피드백'
}

Ref: refresh_token.user_id > user_account.user_id [delete: restrict, update: restrict]
Ref: evaluation_session.user_id > user_account.user_id [delete: restrict, update: restrict]
Ref: question.evaluation_id > evaluation_session.evaluation_id [delete: restrict, update: restrict]
Ref: question.audio_id > audio_asset.audio_id [delete: restrict, update: restrict]
Ref: answer.question_id > question.question_id [delete: restrict, update: restrict]
Ref: answer.audio_id > audio_asset.audio_id [delete: restrict, update: restrict]
Ref: evaluation_report.evaluation_id > evaluation_session.evaluation_id [delete: restrict, update: restrict]
Ref: criterion_result.report_id > evaluation_report.report_id [delete: restrict, update: restrict]
Ref: criterion_feedback.result_id > criterion_result.result_id [delete: restrict, update: restrict]

{
  "name": "@root/trpc-contract",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation.d.ts",
      "default": "./dist/evaluation.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@trpc/server": "11.5.1"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "typesVersions": {
    "*": {
      "report": [
        "dist/report.d.ts"
      ],
      "evaluation": [
        "dist/evaluation.d.ts"
      ]
    }
  }
}

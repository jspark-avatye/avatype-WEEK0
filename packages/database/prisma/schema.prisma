generator client {
  provider = "prisma-client"
  output   = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountState {
  ACTIVE
  DISABLED

  @@map("account_state")
}

enum ProficiencyLevelCode {
  BEGINNER_LOW
  BEGINNER_MID
  BEGINNER_HIGH
  INTERMEDIATE_LOW
  INTERMEDIATE_MID
  INTERMEDIATE_HIGH
  ADVANCED_LOW
  ADVANCED_MID
  ADVANCED_HIGH

  @@map("proficiency_level_code")
}

model UserAccount {
  userId           String                @id @default(uuid()) @map("user_id") @db.Uuid
  loginId          String                @unique @map("login_id") @db.Text
  passwordHash     String                @map("password_hash") @db.Text
  accountStatus    AccountState          @default(ACTIVE) @map("account_status")
  currentLevelCode ProficiencyLevelCode? @map("current_level_code")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  refreshTokens    RefreshToken[]

  @@map("user_account")
}

model RefreshToken {
  tokenId   String      @id @default(uuid()) @map("token_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  tokenHash String      @unique @map("token_hash") @db.Text
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(6)
  user      UserAccount @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("refresh_token")
}

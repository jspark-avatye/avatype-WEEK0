{
  "name": "@root/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "test:auth": "node --test test/auth-flow.test.mjs",
    "test:evaluation": "node --test test/evaluation-flow.test.mjs",
    "test:audio": "node test/run-audio-unit.mjs",
    "test:render": "node --test test/render.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:report:integration": "node --test test/report-flow.test.mjs"
  },
  "dependencies": {
    "@root/trpc-contract": "workspace:*",
    "@trpc/client": "11.5.1",
    "@trpc/react-query": "11.5.1",
    "@tanstack/react-query": "5.87.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "vite": "7.1.5"
  }
}

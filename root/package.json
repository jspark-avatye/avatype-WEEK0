{
  "name": "root",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.20.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/workspace.mjs install",
    "dev": "node scripts/workspace.mjs dev",
    "build": "node scripts/workspace.mjs build",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test:auth": "node scripts/workspace.mjs test:auth",
    "test:evaluation": "node scripts/workspace.mjs test:evaluation",
    "test:render": "node scripts/workspace.mjs test:render",
    "test:evaluation:integration": "node scripts/workspace.mjs test:evaluation:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "node scripts/workspace.mjs db:generate",
    "db:validate": "node scripts/workspace.mjs db:validate",
    "db:migrate:dev": "node scripts/workspace.mjs db:migrate:dev",
    "db:migrate:deploy": "node scripts/workspace.mjs db:migrate:deploy",
    "infra:up": "docker compose up --build -d",
    "infra:down": "docker compose down",
    "stack:up": "docker compose up --build -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f web api",
    "ai:check": "node scripts/workspace.mjs ai:check",
    "test:report": "node scripts/workspace.mjs test:report",
    "test:report:db": "node scripts/workspace.mjs test:report:db",
    "report:check": "node scripts/workspace.mjs report:check",
    "test:report:integration": "node scripts/workspace.mjs test:report:integration"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript-eslint": "8.44.1",
    "typescript": "5.9.2"
  }
}
